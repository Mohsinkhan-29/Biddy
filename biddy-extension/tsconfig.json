{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@content/*": ["./src/content/*"],
      "@background/*": ["./src/background/*"],
      "@sidebar/*": ["./src/sidebar/*"],
      "@styles/*": ["./src/styles/*"]
    },
    "types": ["chrome", "node"]
  },
  "include": ["src", "scripts", "manifest.config.ts"]
}