PORT=4000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Premium plan's higher-tier model (optional, falls back to GEMINI_MODEL)
GEMINI_MODEL_PREMIUM=

# CORS: the extension AND the website, comma-separated
ALLOWED_ORIGINS=chrome-extension://<extension-id>,https://<your-site>.vercel.app,http://localhost:3000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Neon: pooled URL for the app, direct (no "-pooler") URL for migrations
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Extension sign-in: OAuth client of type "Chrome Extension"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Website sign-in: OAuth client of type "Web application"
GOOGLE_WEB_CLIENT_ID=

# Google accounts that can open /admin on the website, comma-separated
ADMIN_EMAILS=
